# ---- Hedera testnet ----
HEDERA_NETWORK=testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# Administrative agent / deployer. Must be an ECDSA account (hex private key).
# Recommended: register at https://portal.hedera.com and create a testnet account (1000 HBAR).
# Alternative: https://portal.hedera.com/faucet funds any EVM address with 100 HBAR per day.
OPERATOR_ACCOUNT_ID=0.0.xxxxxx
OPERATOR_EVM_ADDRESS=0x...
OPERATOR_PRIVATE_KEY=0x...

# ---- Deployed artefacts (filled by ops scripts into deployments/testnet.json) ----

# ---- Privy ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Chainlink CRE ----
CRE_NOTICE_ENDPOINT_URL=

# ---- Hosted demo ----
# Automated institutions: two P-256 private keys (PKCS8 DER base64, comma-separated) that form their
# Privy quorums. The first key is also the automated compliance co-signer on self-service judge desks.
# Generated by `npx tsx scripts/provision-automated-desk.mts` in web/.
AUTOMATED_DESK_KEYS=
# Optional distributed store for multi-instance deployments. Without it, the demo uses its built-in
# single-instance file database under DATA_DIR and requires no external storage setup.
# Required on Vercel (shared store across serverless instances). KV_REST_API_URL / KV_REST_API_TOKEN are accepted too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Private rate-notice endpoint token shared with the CRE workflow (see cre/README.md).
NOTICE_API_TOKEN=

# Browser-only judge workflows. Enable on the host; never expose operator/Privy/Redis secrets in NEXT_PUBLIC variables.
HOSTED_REGISTRY_DEMO_ENABLED=false
ISSUANCE_DEMO_ENABLED=true
ISSUANCE_DEMO_ALLOW_JUDGES=true
ISSUANCE_DEMO_LIMIT=20
# Real administrative actions always require an explicit allow-list on hosted deployments.
PLATFORM_ADMIN_PRIVY_USER_IDS=
# Use a dedicated namespace for each deployment/environment.
STORE_NAMESPACE=syndicatelend
# Privy client configuration (public); add the deployed domain to the Privy allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Test helper: emails (plus-aliases included) that may reset their own desk from the user menu.
DESK_RESET_EMAILS=
# Presentation mode for recordings: show every released holder as paid and evidence as verified. Leave false in real use.
DEMO_PRESENT_ALL_PAID=false
# Set to off on a local dev server that shares the hosted Redis store, so it never drives the same desk wallets as production.
MARKET_TICK=on
