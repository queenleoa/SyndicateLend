{
  "name": "syndicatelend",
  "private": true,
  "version": "0.1.0",
  "description": "Private tokenised syndicated-loan register and RFQ secondary market on Hedera (ATS + HTS + HCS + Scheduled Transactions), with Privy approvals and Chainlink CRE confidential interest calculation.",
  "workspaces": [
    "ops",
    "web"
  ],
  "scripts": {
    "ops": "npm run --workspace ops",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "demo:counterparty": "npm run --workspace web demo:counterparty --",
    "demo:cre": "node cre/scripts/run-demo.mjs",
    "demo:payout": "npm run --workspace ops pay-interest --",
    "demo:controls": "npm run --workspace ops freeze-demo --",
    "typecheck": "npm run --workspace ops typecheck && cd web && npx tsc --noEmit",
    "lint": "npm run --workspace web lint",
    "agent:reconcile": "npm run --workspace ops reconcile --",
    "agent:export": "npm run --workspace ops export-assignments --",
    "demo:feeder": "npm run --workspace ops feeder --"
  },
  "engines": {
    "node": ">=20"
  }
}
